{
  // The "name" MUST match your Worker's name in the Cloudflare dashboard
  // (Workers & Pages -> your project). Cloudflare can't use dots, so a repo
  // called "collaborativeconstructionllc.com" usually becomes the name below.
  // If your Worker is named differently, change this line to match.
  "name": "collaborativeconstructionllc-com",
  "main": "worker/index.js",

  // Turn off the public *.workers.dev address (its subdomain contains the account name).
  // Turning it off only in the dashboard does not last: a deploy sets it again unless
  // this is false. Nothing in this repo points at the workers.dev address. Before the next
  // deploy, check the Cloudflare dashboard (Turnstile hostnames, email, monitors) for any use of it.
  "workers_dev": false,
  "compatibility_date": "2025-06-01",

  // Persist coded errors without request-body/customer-field logging.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },

  // Serve ONLY the Eleventy build output. This previously pointed at "./", the
  // repo root, which meant every file in the repo was public and had to be
  // denied one at a time in .assetsignore. That fails open: /.git and
  // /schema.sql were served until someone noticed, and any new sensitive file
  // is public by default.
  //
  // Pointing at ./_site inverts the default. Nothing is reachable unless
  // Eleventy deliberately wrote it there, which removes the whole bug class
  // and makes .assetsignore unnecessary.
  //
  // Consequence: deploying MUST build first. See the deploy script.
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    // "/api/*" needs the Worker for the intake endpoint. The remaining 17 exact paths
    // are legacy/duplicate URL forms (old .html filenames and no-trailing-slash pages)
    // that need the Worker's own 301 redirect logic in worker/index.js instead of
    // Cloudflare's built-in asset auto-trailing-slash redirect, which is hard-coded to
    // 307 and not configurable. These are listed as exact literal paths, not a
    // wildcard, so no other request (any canonical page, any asset, any future path)
    // is routed through the Worker by this change. See docs/research/18-indexing-audit.md.
    "run_worker_first": [
      "/api/*",
      "/index.html",
      "/about", "/about.html",
      "/gallery", "/gallery.html",
      "/construction-advisory", "/construction-advisory.html",
      "/adu-builder-cape-cod", "/adu-builder-cape-cod.html",
      "/custom-home-builder-cape-cod", "/custom-home-builder-cape-cod.html",
      "/home-additions-cape-cod", "/home-additions-cape-cod.html",
      "/home-renovation-cape-cod", "/home-renovation-cape-cod.html",
      "/general-contractor-falmouth-ma", "/general-contractor-falmouth-ma.html"
    ]
  },

  // Existing production database: Phase 1 tables/triggers already exist.
  // Do not replay migrations during this release; see docs/releases/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cc-leads",
      "database_id": "7e094c32-e89e-4efa-95ce-1133a9b4293c"
    }
  ],

  // Lead notification email. Cloudflare Email Routing is already enabled on
  // this zone (MX points at route*.mx.cloudflare.net), so the native binding
  // sends for free with no API key and no extra DNS records.
  // LEAD_INBOX must be a VERIFIED destination address in Email Routing.
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "destination_address": "collaborativeconstructiongc@gmail.com"
    }
  ],

  // Non-secret config. Secrets (TURNSTILE_SECRET_KEY, and optionally
  // RESEND_API_KEY) are set with `npx wrangler secret put <NAME>` and must
  // never be committed here.
  "vars": {
    // The monitored inbox. Confirmed with the owner: the
    // wes@collaborativeconstructionllc.com address is NOT watched.
    "LEAD_INBOX": "collaborativeconstructiongc@gmail.com",
    // Must be an address on this zone for Email Routing to accept it.
    "LEAD_FROM_ADDRESS": "website@collaborativeconstructionllc.com"
  },

  // Per-IP burst protection, complementing Turnstile. This is not a billing cap.
  // Matches the existing production binding verified on 2026-10-11.
  "ratelimits": [
    { "name": "INTAKE_RATE_LIMITER", "namespace_id": "10041", "simple": { "limit": 5, "period": 60 } }
  ],

  // Private R2 objects are accessible only through account-authorized tools.
  // Per-request limits do not guarantee free-tier spend; review retention/usage.
  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "cc-lead-attachments" }
  ]
}
