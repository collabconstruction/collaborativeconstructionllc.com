{
  // The "name" MUST match your Worker's name in the Cloudflare dashboard
  // (Workers & Pages -> your project). Cloudflare can't use dots, so a repo
  // called "collaborativeconstructionllc.com" usually becomes the name below.
  // If your Worker is named differently, change this line to match.
  "name": "collaborativeconstructionllc-com",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",

  // Serve ONLY the Eleventy build output. This previously pointed at "./", the
  // repo root, which meant every file in the repo was public and had to be
  // denied one at a time in .assetsignore. That fails open: /.git and
  // /schema.sql were served until someone noticed, and any new sensitive file
  // is public by default.
  //
  // Pointing at ./_site inverts the default. Nothing is reachable unless
  // Eleventy deliberately wrote it there, which removes the whole bug class
  // and makes .assetsignore unnecessary.
  //
  // Consequence: deploying MUST build first. See the deploy script.
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS"
  },

  // Lead records. Schema lives in schema.sql:
  //   npx wrangler d1 execute cc-leads --file=schema.sql --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cc-leads",
      "database_id": "7e094c32-e89e-4efa-95ce-1133a9b4293c"
    }
  ],

  // Lead notification email. Cloudflare Email Routing is already enabled on
  // this zone (MX points at route*.mx.cloudflare.net), so the native binding
  // sends for free with no API key and no extra DNS records.
  // LEAD_INBOX must be a VERIFIED destination address in Email Routing.
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "destination_address": "collaborativeconstructiongc@gmail.com"
    }
  ],

  // Non-secret config. Secrets (TURNSTILE_SECRET_KEY, and optionally
  // RESEND_API_KEY) are set with `npx wrangler secret put <NAME>` and must
  // never be committed here.
  "vars": {
    // The monitored inbox. Confirmed with the owner: the
    // wes@collaborativeconstructionllc.com address is NOT watched.
    "LEAD_INBOX": "collaborativeconstructiongc@gmail.com",
    // Must be an address on this zone for Email Routing to accept it.
    "LEAD_FROM_ADDRESS": "website@collaborativeconstructionllc.com"
  },

  // R2 attachment storage for project photos sent through the contact form.
  //
  // The owner asked for a guarantee this never costs money. There is no hard
  // spending cap on R2, so the guarantee is enforced in code instead: the
  // Worker caps uploads at 6 files, 10 MB each, 25 MB per submission, and an
  // allowlist of image/PDF types, behind Turnstile. Free tier is 10 GB, so
  // reaching it would take roughly 2,000 photos. Those limits live in
  // worker/index.js (MAX_FILES, MAX_FILE_BYTES, ALLOWED_TYPES) and are the
  // thing to check before anyone loosens them.
  //
  // If this binding is ever removed, the Worker rejects uploads with a clear
  // message rather than accepting files and dropping them.
  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "cc-lead-attachments" }
  ]
}
