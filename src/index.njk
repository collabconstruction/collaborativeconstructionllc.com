        <div class="contact-grid">

          <!-- form -->
          <div class="form-card" data-reveal="left">
            <span class="spot-extra" aria-hidden="true"></span>
            <form id="contact-form" action="/api/contact" method="post" enctype="multipart/form-data" novalidate>
              <p class="form-note">Name, email and a short message are required. Other details are optional.</p>
              {#- Each required control carries an empty .field__error that
                  js/main.js fills in, and points at it with aria-describedby
                  so a screen reader announces the message with the field
                  rather than only in the shared status line at the bottom. #}
              <div class="field">
                <label for="cc-name">Name</label>
                <input id="cc-name" name="name" type="text" autocomplete="name" placeholder="Your name" maxlength="120" required aria-describedby="cc-name-error">
                <p class="field__error" id="cc-name-error"></p>
              </div>
              <div class="field">
                <label for="cc-email">Email</label>
                <input id="cc-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" maxlength="254" required aria-describedby="cc-email-error">
                <p class="field__error" id="cc-email-error"></p>
              </div>
              <div class="field-row">
                <div class="field">
                  <label for="cc-phone">Phone (optional)</label>
                  <input id="cc-phone" name="phone" type="tel" autocomplete="tel" maxlength="40">
                </div>
                <div class="field">
                  <label for="cc-town">Project town (optional)</label>
                  <input id="cc-town" name="project_town" type="text" maxlength="100" autocomplete="address-level2">
                </div>
              </div>
              <div class="field">
                <label for="cc-project-type">Project type (optional)</label>
                <select id="cc-project-type" name="project_type">
                  <option value="">Please select if known</option>
                  <option value="general_contracting">Residential general contracting</option>
                  <option value="addition">Home addition</option>
                  <option value="adu">Accessory dwelling unit (ADU)</option>
                  <option value="renovation">Renovation</option>
                  <option value="custom_home">Custom home</option>
                  <option value="advisory">Construction advisory / owner's representation</option>
                  <option value="other">Other / not sure yet</option>
                </select>
              </div>
              {#- budget_range and desired_timeline were already accepted,
                  length-checked, written to lead_workflow and included in the
                  idempotency fingerprint by worker/index.js — the form simply
                  never offered them, so every lead arrived without the two
                  details that decide whether a job is worth a site visit.
                  These are free text, not a priced menu: the company has
                  published no prices and none are implied here. #}
              <div class="field-row">
                <div class="field">
                  <label for="cc-budget">Budget range (optional)</label>
                  <input id="cc-budget" name="budget_range" type="text" maxlength="100" placeholder="A range or “not sure yet”">
                </div>
                <div class="field">
                  <label for="cc-timeline">Timing (optional)</label>
                  <input id="cc-timeline" name="desired_timeline" type="text" maxlength="150" placeholder="e.g. next spring, no fixed date">
                </div>
              </div>
              <div class="field">
                <label for="cc-message">Message</label>
                <textarea id="cc-message" name="message" placeholder="What would you like to build or improve? Include your town and timing if known." maxlength="5000" required aria-describedby="cc-message-error"></textarea>
                <p class="field__error" id="cc-message-error"></p>
              </div>
              <div class="field">
                <label for="cc-files">Photos or plans (optional)</label>
                <input id="cc-files" name="attachments" type="file" multiple aria-describedby="cc-files-help"
                       accept="image/jpeg,image/png,image/webp,image/heic,image/heif,application/pdf">
                <p id="cc-files-help" class="form-note">Up to 6 images or PDFs, 10 MB each and 25 MB total. Please omit financial records and sensitive personal information.</p>
                <ul class="file-list" aria-live="polite"></ul>
              </div>
              {% if intake.turnstileSiteKey %}
              <script src="/js/turnstile-lifecycle.js"></script>
              <div id="cc-turnstile" class="cf-turnstile" data-sitekey="{{ intake.turnstileSiteKey }}" data-action="contact"
                data-callback="ccChallengeSuccess" data-expired-callback="ccChallengeExpired"
                data-timeout-callback="ccChallengeTimeout" data-error-callback="ccChallengeError"
                data-refresh-expired="auto" data-refresh-timeout="auto"></div>
              <p id="challenge-status" role="status" aria-live="polite"></p>
              <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
              {% endif %}
              <noscript><p>Please call <a href="{{ business.phoneHref }}">{{ business.phone }}</a> or email <a href="mailto:{{ business.email }}">{{ business.email }}</a> to inquire without JavaScript.</p></noscript>
              <!-- Honeypot: hidden from people, tempting to bots. Never fill this. -->
              <div class="hp-field" hidden inert aria-hidden="true">
                <label for="cc-x7q2m9">Leave this field blank</label>
                <input id="cc-x7q2m9" name="cc_x7q2m9" type="text" tabindex="-1" autocomplete="off"
                       autocapitalize="off" spellcheck="false" data-1p-ignore data-lpignore="true" data-bwignore>
              </div>

              <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Send Inquiry</button>
              <p class="form-status" role="status" aria-live="polite"></p>
            </form>
