{#
  Projects page (file and URL keep the name gallery): one page, projects grouped by type (src/_data/projects.json, field `type`). Residential types come first, the ones the
  company wants to promote; Commercial is last. A type with no projects is skipped, so adding a new type only needs projects in the data.
  No tabs, no towns, no captions inside the photos. A project with more than one photo gets two plain arrows (added by js/gallery.js);
  without JavaScript the first photo of each project shows and the arrows stay hidden. Photos only change when the visitor clicks.
#}
{%- macro pic(img, sizes, first) -%}
{%- set base = img.src | replace("/assets/img/", "") | replace(".jpg", "") -%}
<picture><source type="image/webp" srcset="{% for w in img.widths %}/assets/img/r/{{ base }}-{{ w }}.webp {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ sizes }}"><img src="{{ img.src }}" alt="{{ img.alt }}" width="{{ img.w }}" height="{{ img.h }}" {% if first %}decoding="async"{% else %}loading="lazy" decoding="async"{% endif %}></picture>
{%- endmacro -%}
{%- macro slot(p, sizes, interval) -%}
<div class="gallery-slot">
  {%- for img in p.images %}
  <div class="gallery-frame{% if loop.first %} is-live{% endif %}">{{ pic(img, sizes, loop.first) }}</div>
  {%- endfor %}
</div>
{%- endmacro -%}
{%- set groups = [
  { type: "custom-homes", title: "Custom homes" },
  { type: "kitchen-remodels", title: "Kitchen remodels" },
  { type: "bath-remodels", title: "Bath remodels" },
  { type: "pool-projects", title: "Pool projects" },
  { type: "exteriors", title: "Exteriors" },
  { type: "decks-and-railings", title: "Decks and railings" },
  { type: "porches-and-balconies", title: "Porches and balconies" },
  { type: "commercial", title: "Commercial projects" }
] -%}

<section class="about-page-hero">
  <div class="container">
    <h1>Projects</h1>
    <hr class="rule" style="margin:18px auto 0">
    <p class="hero-lede">Residential and commercial project photography.</p>
  </div>
</section>

{%- set byType = projects.items | groupby("type") -%}
<section class="gallery-stage project-gallery">
  {%- for g in groups %}
  {%- set items = byType[g.type] %}
  {%- if items %}
  <section class="gallery-group{% if g.type == "commercial" %} gallery-group--commercial{% endif %}" id="{{ g.type }}" aria-labelledby="{{ g.type }}-heading">
    <h2 id="{{ g.type }}-heading">{{ g.title }}</h2>
    <div class="gallery-grid">
      {%- for p in items %}
      <figure class="gallery-card">
        <div class="gallery-media" data-slides="{{ p.images | length }}">
          {{ slot(p, "(min-width: 1100px) 30vw, (min-width: 640px) 46vw, 92vw", 0) }}
          {%- if p.images | length > 1 %}
          <button class="gallery-arrow gallery-arrow--prev" type="button" hidden aria-label="Previous photo of {{ p.title }}"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M15 4 7 12l8 8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <button class="gallery-arrow gallery-arrow--next" type="button" hidden aria-label="Next photo of {{ p.title }}"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="m9 4 8 8-8 8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <span class="visually-hidden" role="status" aria-live="polite"></span>
          {%- endif %}
        </div>
        <figcaption><span class="gallery-card__title">{{ p.title }}</span>{% if p.shows %}<span class="gallery-card__shows">{{ p.shows }}</span>{% endif %}</figcaption>
      </figure>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}
  {%- endfor %}
</section>

<section class="section adu svc-cta">
  <div class="container" data-reveal>
    <h2 data-reveal-words>Discuss your project</h2>
    <p>Let's talk about your project: scope, location and timing.</p>
    <a href="/#contact" class="btn btn-primary">Contact us today</a>
  </div>
</section>
