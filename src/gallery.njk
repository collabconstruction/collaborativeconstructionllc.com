{#
  Gallery: three views of the same projects (src/_data/projects.json), each laid out its own way.
    all          a collage of cycling photo tiles
    residential  editorial rows: title, then the town under it, then a short line
    commercial   full width bands
  No buttons, no boxes, no captions inside the photos. Each photo slot cycles through its project's pictures
  (js/gallery.js). Without JavaScript every view shows one after the other and the first photo of each slot is visible.
  Deck and Railings and Porches and Upper Balcony are last on purpose.
#}
{%- macro pic(img, sizes, first) -%}
{%- set base = img.src | replace("/assets/img/", "") | replace(".jpg", "") -%}
<picture><source type="image/webp" srcset="{% for w in img.widths %}/assets/img/r/{{ base }}-{{ w }}.webp {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ sizes }}"><img src="{{ img.src }}" alt="{{ img.alt }}" width="{{ img.w }}" height="{{ img.h }}" {% if first %}decoding="async"{% else %}loading="lazy" decoding="async"{% endif %}></picture>
{%- endmacro -%}
{%- macro slot(p, sizes, interval) -%}
<div class="gallery-slot" data-cycle data-interval="{{ interval }}">
  {%- for img in p.images %}
  <div class="gallery-frame{% if loop.first %} is-live{% endif %}">{{ pic(img, sizes, loop.first) }}</div>
  {%- endfor %}
</div>
{%- endmacro -%}
{%- set order = ["Custom Residence", "Modern Custom Residence", "Lovell Dormitory", "Residential Exterior", "Commercial Dispensary", "CubeSmart Self Storage", "Deck and Railings", "Porches and Upper Balcony"] -%}

<section class="about-page-hero">
  <div class="container">
    <h1>Gallery</h1>
    <hr class="rule" style="margin:18px auto 0">
    <p class="hero-lede">Residential and commercial project photography.</p>
  </div>
</section>

<section class="gallery-stage project-gallery">
  <nav class="gallery-views" aria-label="Project views">
    <a href="#all" data-gallery-tab="all" aria-current="true">All projects</a>
    <a href="#residential" data-gallery-tab="residential">Residential</a>
    <a href="#commercial" data-gallery-tab="commercial">Commercial</a>
  </nav>

  <div class="gallery-view gallery-view--all" data-gallery-view="all" id="all">
    <h2 class="visually-hidden">All projects</h2>
    <div class="gallery-collage">
      {%- for title in order %}{% set ti = loop.index %}{% for p in projects.items %}{% if p.title == title %}
      <figure class="gallery-tile gallery-tile--{{ ti }}" data-project-category="{{ p.category }}">
        {{ slot(p, "(min-width: 1100px) 30vw, (min-width: 640px) 46vw, 92vw", 5200 + (ti * 700)) }}
        <figcaption><span class="gallery-tile__title">{{ p.title }}</span><span class="gallery-tile__town">{{ p.location }}</span></figcaption>
      </figure>
      {%- endif %}{% endfor %}{% endfor %}
    </div>
  </div>

  <div class="gallery-view gallery-view--residential" data-gallery-view="residential" id="residential">
    <h2 class="visually-hidden">Residential projects</h2>
    {%- for title in order %}{% set ti = loop.index %}{% for p in projects.items %}{% if p.title == title and p.category == "Residential" %}
    <article class="gallery-row{% if p.compact %} gallery-row--compact{% endif %}" data-reveal>
      <div class="gallery-row__media">{{ slot(p, "(min-width: 900px) 58vw, 92vw", 6200 + (ti * 600)) }}</div>
      <div class="gallery-row__text">
        <h3>{{ p.title }}</h3>
        <p class="gallery-row__place">{{ p.location }}</p>
        {%- if p.shows %}<p class="gallery-row__shows">{{ p.shows }}</p>{% endif %}
      </div>
    </article>
    {%- endif %}{% endfor %}{% endfor %}
  </div>

  <div class="gallery-view gallery-view--commercial" data-gallery-view="commercial" id="commercial">
    <h2 class="visually-hidden">Commercial projects</h2>
    {%- for title in order %}{% set ti = loop.index %}{% for p in projects.items %}{% if p.title == title and p.category == "Commercial" %}
    <article class="gallery-band">
      {{ slot(p, "100vw", 6000 + (ti * 800)) }}
      <div class="gallery-band__shade"></div>
      <div class="gallery-band__text">
        <h3>{{ p.title }}</h3>
        <p class="gallery-band__place">{{ p.location }}</p>
        {%- if p.shows %}<p class="gallery-band__shows">{{ p.shows }}</p>{% endif %}
      </div>
      <span class="gallery-band__dots" aria-hidden="true">{% for img in p.images %}<i{% if loop.first %} class="is-live"{% endif %}></i>{% endfor %}</span>
    </article>
    {%- endif %}{% endfor %}{% endfor %}
  </div>
</section>

<section class="section adu svc-cta">
  <div class="container" data-reveal>
    <h2 data-reveal-words>Discuss Your Project</h2>
    <p>Let's talk about your project: scope, location and timing.</p>
    <a href="/#contact" class="btn btn-primary">Contact Us Today</a>
  </div>
</section>
