{#-
  One macro renders every project. This page used to carry seven hand-written
  copies of the same 30-line block, which is why the labelling had drifted:
  each project showed a title and a town and nothing else, so a visitor could
  not tell a dispensary fit-out from a bath remodel without reading captions.
  Content now lives in src/_data/projects.json.

  `featured` only changes the image loading hint. The first project sits above
  the fold-ish, so its opening photograph is fetched eagerly; every other
  image stays lazy.
-#}
{%- macro project(p, featured = false) %}
        <article class="project" data-reveal>
          <header class="project-head">
            <h2>{{ p.title }}</h2>
            <p class="project-meta">
              <span class="tag tag--cat">{{ p.category }}</span>
              <span class="tag">{{ p.location }}</span>
              <span class="project-count">{{ p.images | length }} photos</span>
            </p>
            {#- `shows` names which parts of the building are pictured. It is a
                summary of this project's own captions, deliberately not a
                scope-of-work claim. -#}
            <p class="project-shows">{{ p.shows }}</p>
          </header>
          <div class="carousel">
            <div class="carousel__track">
              {%- for img in p.images %}
              <div class="carousel__slide">
                <img src="{{ img.src }}" alt="{{ img.alt }}"
                     {% if featured and loop.first %}loading="eager"{% else %}loading="lazy"{% endif %} decoding="async">
                <div class="carousel__caption">{{ img.caption }}</div>
              </div>
              {%- endfor %}
            </div>
            {#- The "2 / 6" counter is built by main.js, not written here, so
                that all eight carousels on the site get it from one place —
                and so it never claims the photos are browsable on a page
                where the script failed to load. -#}
            {%- if p.images | length > 1 %}
            <button class="carousel__btn prev" type="button" aria-label="Previous photo of {{ p.title }}">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button class="carousel__btn next" type="button" aria-label="Next photo of {{ p.title }}">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>
            {#- Not role="tablist": the buttons JS builds are not tabs and do
                not control tabpanels. A labelled group with aria-current is
                what this control actually is. -#}
            <div class="carousel__dots" role="group" aria-label="Choose a photo of {{ p.title }}"></div>
            {%- endif %}
          </div>
        </article>
{%- endmacro %}

    <!-- ============================ GALLERY INTRO ============================ -->
    <section class="gallery-intro">
      <div class="container">
        <div class="two-col">
          <img class="mark" src="/assets/c-icon.png" alt="" data-reveal="left">
          <div data-reveal="right">
            <span class="eyebrow">Our Work</span>
            <h1>Gallery</h1>
            <p>Showcasing a sample of completed projects ranging from Residential Construction, Kitchen and Bath Remodels, Custom Home Renovations, and Commercial Tenant Fit-outs.</p>
            {#- PROPOSED COPY - NEEDS OWNER SIGN-OFF BEFORE IT STAYS.

                The page previously read as "we built all of these." Research
                ('Website Evidence and Business Facts.md') says attribution per
                project is unconfirmed and warns against implying sole company
                authorship of every pictured building - and the gallery does
                contain a 50,000 SF dormitory and a national-brand storage
                facility alongside bath remodels.

                Rather than guess a role per project, this says roles varied
                and offers the real answer on request. If the owner confirms
                attribution, replace this with per-project roles in
                projects.json and delete the paragraph. -#}
            <p class="gallery-note">
              This work spans {{ people.wesleigh.name }}'s {{ people.wesleigh.yearsExperience }}+ years in residential and commercial construction, and his role differed from project to project. Ask about any project here and you will get a straight answer about what it involved.
            </p>
          </div>
        </div>
      </div>
    </section>

    <div class="section-divider" data-reveal aria-hidden="true">
      <span class="line"></span><span class="gem"></span><span class="line r"></span>
    </div>

    <!-- ============================ PROJECTS ============================ -->
    <section class="projects">
      <div class="container">

        {#- The first project runs full width as the featured one; the rest
            pair up in .projects-grid and wrap as more are added. To add a
            project, append an entry to src/_data/projects.json - there is no
            markup to copy any more. -#}
        {%- for p in projects.items %}{% if loop.first %}{{ project(p, true) }}{% endif %}{% endfor %}

        <!-- divider between the featured project and the paired grid below -->
        <div class="project-divider section-divider" data-reveal aria-hidden="true">
          <span class="line"></span><span class="gem"></span><span class="line r"></span>
        </div>

        <div class="projects-grid">
        {%- for p in projects.items %}{% if not loop.first %}{{ project(p) }}{% endif %}{% endfor %}
        </div><!-- /.projects-grid -->

      </div>
    </section>

    <!-- ============================ CTA ============================ -->
    {#- The gallery was a dead end: seven projects and then the footer. This
        is the same `.section.adu.svc-cta` band every service page already
        closes with, not a new component — the point of the band is that it
        looks identical wherever you meet it. -#}
    <section class="section adu svc-cta">
      <div class="container" data-reveal>
        <span class="eyebrow eyebrow--boom" data-reveal="boom">Get in Touch</span>
        <span class="svc-cta__photo"><img src="/assets/img/wesleigh-behn.jpg" alt="Wesleigh Behn, Owner &amp; Founder"></span>
        <h2 data-reveal-words>Planning Something Like This?</h2>
        <p>Tell us what you have in mind and we'll talk through how it gets built, what it involves, and what to expect.</p>
        <a href="/#contact" class="btn btn-primary">Contact Us Today</a>
      </div>
    </section>
