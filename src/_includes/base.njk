{#
  The single page shell. Previously this markup was copy-pasted across four
  HTML files, which is how the head blocks and JSON-LD started to drift.

  Front matter each page must set:
    title           <title> text (brand suffix is appended here)
    description     meta description
    permalink       output URL, e.g. "/about/index.html"
    canonical       canonical path, e.g. "/about"
    schemaType      selects JSON-LD nodes: home | gallery | services | service | about
                    (home is implicit from url === "/"; "services" emits one
                    Service node per entry in services.json onto a shared
                    page (construction-advisory); "service" emits a single
                    Service node for this page itself, named/described from
                    this same front matter — use it on a dedicated service
                    landing page such as the ADU/custom-home/additions/
                    renovation/general-contractor pages)
  Optional:
    ogType          defaults to "website"
    ogTitle         defaults to title
    ogDescription   defaults to description
    twitterDescription  short share copy; defaults to ogDescription
    schemaName      JSON-LD WebPage name; defaults to title. Prefer a human
                    label ("Project Gallery") over the brand-suffixed <title>.
    breadcrumbName  breadcrumb leaf name; defaults to schemaName, then title
    shareImage      defaults to business.images.share
    shareImageAlt
#}<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="theme-color" content="#2b2d31">
  <link rel="canonical" href="{{ business.url }}{{ canonical }}">

  <meta property="og:type" content="{{ ogType | default('website') }}">
  <meta property="og:site_name" content="{{ business.name }}">
  <meta property="og:url" content="{{ business.url }}{{ canonical }}">
  <meta property="og:title" content="{{ ogTitle | default(title) }}">
  <meta property="og:description" content="{{ ogDescription | default(description) }}">
  <meta property="og:image" content="{{ business.url }}{{ shareImage | default(business.images.share) }}">
  <meta property="og:image:width" content="{{ shareImageWidth | default(business.images.shareWidth) }}">
  <meta property="og:image:height" content="{{ shareImageHeight | default(business.images.shareHeight) }}">
  <meta property="og:image:alt" content="{{ shareImageAlt | default('Custom home built by Collaborative Construction') }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ ogTitle | default(title) }}">
  <meta name="twitter:description" content="{{ twitterDescription | default(ogDescription) | default(description) }}">
  <meta name="twitter:image" content="{{ business.url }}{{ shareImage | default(business.images.share) }}">

  {#- The LCP image. It is a CSS background (.hero__bg), so without this the
      browser cannot discover it until styles.css has downloaded and parsed,
      which serialises two round trips before the largest paint even starts. #}
  {%- if preloadImage %}
  <link rel="preload" as="image" href="{{ preloadImage }}" fetchpriority="high">
  {%- endif %}
  <link rel="icon" type="image/png" href="/assets/favicon.png">
  <link rel="apple-touch-icon" href="/assets/c-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500;1,600&family=Inter:wght@400;500;600;700&family=Roboto+Slab:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  {#- Every [data-reveal] block starts at opacity:0 and is only un-hidden by
      main.js, and .motto-word/.rw-word start hidden too. With JavaScript
      disabled that renders the whole page blank — including the no-JS contact
      fallback inside .form-card, which names the phone number and email for
      exactly this visitor and was itself invisible. This restores the end
      state for them. It cannot affect the scripted path: a <noscript> style
      is inert whenever scripting is enabled. -#}
  <noscript>
    <style>
      [data-reveal], .motto-word, .rw-word { opacity: 1 !important; transform: none !important; }
    </style>
  </noscript>
  <script>
    /* Apply directional page-entrance class before first paint (no flash) */
    (function () {
      try {
        var d = sessionStorage.getItem("navDir");
        if (d) {
          document.documentElement.classList.add(d === "right" ? "enter-right" : "enter-left");
          sessionStorage.removeItem("navDir");
        }
      } catch (e) {}
    })();
  </script>

  {# GA is loaded by analytics.js only after explicit consent. #}
  {%- if analytics.ga4MeasurementId %}
  <script>
    window.__CC_ANALYTICS = {
      measurementId: {{ analytics.ga4MeasurementId | dump | safe }},
      consent: {{ analytics.consent | dump | safe }}
    };
  </script>
  {%- endif %}

  {# Generated from src/_data. Never hand-edit structured data again. #}
  <script type="application/ld+json">
{{ { url: canonical, title: title, description: description, schemaName: schemaName, breadcrumbName: breadcrumbName, schemaType: schemaType, business: business, people: people, services: services.list } | jsonld | safe }}
  </script>
</head>
<body>

  <!-- ============================ HEADER ============================ -->
  <a class="skip-link" href="#main">Skip to main content</a>

  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="{{ business.shortName }} home">
        <img class="c-badge" src="{{ business.images.badge }}" alt="">
        <img class="logo" src="{{ business.images.logoHeader }}" alt="{{ business.shortName }}">
      </a>
      <div class="header-right">
        {#- `Services` carries a `dropdown` array in src/_data/nav.json but no
            template ever rendered it, so it fell through to `<a href="">` —
            a dead link that just reloaded the current page, on every page of
            the site. That made all five service landing pages reachable only
            from the homepage grid or the footer. It now renders as a real
            disclosure: a <button> plus a panel, opened on hover and on
            :focus-within (so it works for pointer, touch and keyboard with
            no JavaScript), and expanded inline in the mobile sheet. #}
        <nav class="nav" id="primary-nav" aria-label="Primary">
          {%- for item in nav.items %}
          {%- if item.dropdown %}
          {%- set groupActive = false %}
          {%- for sub in item.dropdown %}{% if sub.url == canonical %}{% set groupActive = true %}{% endif %}{%- endfor %}
          <div class="nav-group">
            <button type="button" class="nav-group__trigger{% if groupActive %} active{% endif %}" aria-expanded="false" aria-controls="nav-services">
              {{ item.label }}
              <svg class="nav-group__chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="nav-group__panel" id="nav-services">
              {%- for sub in item.dropdown %}
              <a href="{{ sub.url }}"{% if sub.url == canonical %} class="active" aria-current="page"{% endif %}>{{ sub.label }}</a>
              {%- endfor %}
            </div>
          </div>
          {%- else %}
          <a href="{{ item.url }}"{% if item.url == canonical %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a>
          {%- endif %}
          {%- endfor %}
        </nav>
        <div class="header-cta">
          <a href="/#contact" class="btn btn-gold btn-sm">Get in Touch</a>
          <a href="{{ business.phoneHref }}" class="header-cta__icon" aria-label="Call {{ business.shortName }}">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </a>
        </div>
        <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="primary-nav">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <main class="page-main" id="main" tabindex="-1">
{{ content | safe }}
  </main>

  <!-- ============================ FOOTER ============================ -->
  <footer class="site-footer footer">
    <div class="container footer-top">
      <div class="footer-brand">
        <div class="footer-logo">
          <img class="c-badge" src="{{ business.images.badge }}" alt="">
          <span class="wm">Collaborative<br>Construction</span>
        </div>
        <p class="eyebrow gold motto-words">Experience <span class="dot" style="color:var(--gold-2)">·</span> Quality <span class="dot" style="color:var(--gold-2)">·</span> Trust</p>
        <p>{{ business.footerBlurb | safe }}</p>
      </div>

      <div class="footer-col">
        <h4>Explore</h4>
        <ul class="footer-links">
          {#- A menu heading has no url, so list its children in its place
              rather than emitting `<a href="">`. #}
          {%- for item in nav.items %}
          {%- if item.dropdown %}
          {%- for sub in item.dropdown %}
          <li><a href="{{ sub.url }}">{{ sub.label }}</a></li>
          {%- endfor %}
          {%- else %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {%- endif %}
          {%- endfor %}
          {%- for item in nav.footerExtra %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Contact</h4>
        <address class="footer-contact">
          {{ business.name }}<br>
          <a href="{{ business.address.mapUrl }}" target="_blank" rel="noopener">{{ business.address.display }}</a><br><br>
          <a href="mailto:{{ business.email }}">{{ business.email }}</a>
          <a href="{{ business.phoneHref }}">{{ business.phone }}</a>
        </address>
        {#- Hours are emitted as openingHours in the JSON-LD, so they have to be
            visible here too: structured data must never claim what the page
            does not say. #}
        {%- if business.hoursDisplay %}
        <ul class="footer-hours">
          {%- for h in business.hoursDisplay %}
          <li><span>{{ h.days }}</span> <span>{{ h.time }}</span></li>
          {%- endfor %}
        </ul>
        {%- endif %}
        <div class="socials">
          <a href="{{ business.social.facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
          </a>
          <a href="{{ business.social.linkedin }}" aria-label="LinkedIn" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h4>Recent Work</h4>
        {#- These two thumbnails used to hardcode a title, town and image that
            also appear on /gallery/ — in the footer of every page. Renaming a
            project in projects.json would have left this strip quietly
            disagreeing with the gallery it links to, so it now reads the same
            data and shows whichever entries carry `footerThumb`. -#}
        <div class="footer-projects">
          {%- for p in projects.items %}{% if p.footerThumb %}
          <a class="footer-project" href="/gallery/">
            <img src="{{ p.footerThumb.src }}" alt="{{ p.footerThumb.alt }}" loading="lazy">
            <span>{{ p.title }}<small>{{ p.location }}</small></span>
          </a>
          {%- endif %}{% endfor %}
        </div>
        <a class="footer-projects-link" href="/gallery/">View full gallery &rarr;</a>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="container" style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;width:100%">
        <span>&copy; <span id="year">2026</span> {{ business.name }}. All rights reserved.</span>
        <span>Website by {{ business.name }}</span>
      </div>
    </div>
  </footer>

  <button class="to-top" aria-label="Back to top">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
  </button>

  {#- Cloudflare Web Analytics. Cookieless, so it needs no consent banner and
      loads for everyone. `defer` keeps it off the critical path: measurement
      must never be the reason a page paints slower. #}
  {%- if analytics.cloudflareToken %}
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ analytics.cloudflareToken }}"}'></script>
  {%- endif %}

  {#- Before main.js, so the form_start listener is attached before anything
      heavier runs. Inert unless GA4 is configured. #}
  <script src="/js/intake-context.js"></script>
  <script src="/js/analytics.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
