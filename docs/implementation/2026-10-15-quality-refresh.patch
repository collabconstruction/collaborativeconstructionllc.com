diff --git a/css/styles.css b/css/styles.css
index fede481..b2dcfa8 100644
--- a/css/styles.css
+++ b/css/styles.css
@@ -3797,3 +3797,39 @@ figure {
  .scope-tile__number { margin-bottom: 10px; }
  .project-gallery .project-head { min-height: 0; }
 }
+
+/* Contact, project browsing and closing panels share the brass frame. */
+.contact-grid { align-items: stretch; gap: 24px; }
+.contact-info { display: flex; flex-direction: column; padding: clamp(26px, 4vw, 46px); background: var(--navy); color: var(--paper); border: 1px solid var(--brass); border-radius: var(--radius-lg); }
+.contact-info h3 { color: var(--paper); font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1.18; }
+.contact-info .eyebrow, .contact-info .label { color: var(--brass); }
+.contact-info .lede, .contact-info .value, .contact-info .info-row:hover .value { color: var(--paper); }
+.contact-preparation { margin-block: 24px; padding-block: 24px; border-block: 1px solid rgba(189,161,106,.35); }
+.contact-preparation h4 { color: var(--paper); font-size: 1rem; margin-bottom: 14px; }
+.contact-preparation ul { padding-left: 20px; line-height: 1.9; }
+.contact-preparation p { margin: 18px 0 0; font-size: .9rem; color: var(--navy-200); }
+.contact-info .info-list { margin-block: 0 28px; }
+.contact-info .ico { background: rgba(189,161,106,.13); color: var(--brass); border: 1px solid rgba(189,161,106,.35); }
+.contact-direct { margin-top: auto; text-align: center; }
+.contact .form-card { border: 1px solid var(--brass); box-shadow: 0 16px 44px rgba(9,24,42,.08); }
+.svc-cta { background: var(--paper-2); padding-block: clamp(36px, 5vw, 72px); }
+.svc-cta::after { display: none; }
+.svc-cta .container { padding: clamp(30px, 5vw, 62px) 24px; border: 1px solid var(--brass); border-radius: var(--radius-lg); background: var(--navy); box-shadow: 0 14px 40px rgba(9,24,42,.12); }
+.svc-cta h2, .svc-cta p { color: var(--paper); }
+.svc-cta .eyebrow { color: var(--brass); }
+.svc-cta h2 { margin-bottom: 20px; }
+.svc-cta .btn { margin-top: 12px; }
+.site-footer { border-top: 1px solid var(--brass); }
+.site-footer::before { inset: 7px 0 auto; width: 100%; height: 1px; aspect-ratio: auto; transform: none; border: 0; border-radius: 0; background: linear-gradient(90deg, transparent, var(--brass), transparent); opacity: .4; }
+.project-filters { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
+.project-filters[hidden], .project-gallery .project[hidden] { display: none; }
+.project-filters button { border: 1px solid var(--line); border-radius: 4px; padding: 12px 20px; color: var(--navy); background: var(--surface); font: inherit; font-size: .85rem; cursor: pointer; }
+.project-filters button[aria-pressed="true"] { background: var(--navy); border-color: var(--navy); color: var(--paper); }
+.project-filters button:focus-visible { outline: 3px solid var(--brass); outline-offset: 3px; }
+.project-results { min-height: 1.5em; text-align: center; font-size: .85rem; margin: 12px 0 22px; }
+.project-gallery .project--featured { grid-column: 1 / -1; }
+.project-gallery .project--featured .project-head { min-height: 0; }
+.project-gallery .project { border-top: 2px solid var(--brass); }
+@media (max-width: 600px) { .contact-info { padding: 24px; } .svc-cta .container { width: 92%; } }
+
+.project-gallery .project-results { max-width: none; text-align: center; }
