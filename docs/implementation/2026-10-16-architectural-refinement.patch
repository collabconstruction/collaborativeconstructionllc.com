diff --git a/scripts/build-house.mjs b/scripts/build-house.mjs
new file mode 100644
index 0000000..c0a870d
--- /dev/null
+++ b/scripts/build-house.mjs
@@ -0,0 +1,40 @@
+import {build} from 'esbuild';
+import {readFile,writeFile,mkdir} from 'node:fs/promises';
+import {gzipSync} from 'node:zlib';
+import * as T from 'three';
+import {GLTFExporter} from 'three/addons/exporters/GLTFExporter.js';
+import {createHouse,disposeHouse} from '../lib/house/model.mjs';
+await mkdir('assets/models',{recursive:true});
+await build({entryPoints:['lib/house/runtime.mjs'],bundle:true,minify:true,format:'esm',target:'es2022',outfile:'js/house-scene.js',legalComments:'eof'});
+await writeFile('assets/models/THREE-LICENSE.txt',await readFile('node_modules/three/LICENSE'));
+// Node bridge for the exporter's browser FileReader dependency. No textures.
+globalThis.FileReader=class {
+ readAsArrayBuffer(blob){blob.arrayBuffer().then(v=>{this.result=v;this.onloadend?.();});}
+ readAsDataURL(blob){blob.arrayBuffer().then(v=>{this.result=`data:${blob.type};base64,${Buffer.from(v).toString('base64')}`;this.onloadend?.();});}
+};
+const {root,groups}=createHouse();
+const glb=await new GLTFExporter().parseAsync(root,{binary:true,onlyVisible:false});
+await writeFile('assets/models/residential-study.glb',Buffer.from(glb));
+// A deterministic static SVG of the same geometry: no GPU or image dependencies.
+const camera=new T.OrthographicCamera(-6.9,6.9,5,-5,.1,100);camera.position.set(9,7,11);camera.lookAt(0,1.4,0);camera.updateMatrixWorld();root.updateMatrixWorld(true);
+const triangles=[];const a=new T.Vector3(),b=new T.Vector3(),c=new T.Vector3();
+root.traverse(mesh=>{
+ if(!mesh.isMesh || mesh.parent===groups.interior)return;
+ const geo=mesh.geometry.index?mesh.geometry.toNonIndexed():mesh.geometry;
+ const positions=geo.attributes.position;
+ for(let i=0;i<positions.count;i+=3){
+  a.fromBufferAttribute(positions,i).applyMatrix4(mesh.matrixWorld);b.fromBufferAttribute(positions,i+1).applyMatrix4(mesh.matrixWorld);c.fromBufferAttribute(positions,i+2).applyMatrix4(mesh.matrixWorld);
+  const normal=new T.Vector3().subVectors(b,a).cross(new T.Vector3().subVectors(c,a)).normalize();
+  if(normal.dot(new T.Vector3().subVectors(camera.position,a))<=0)continue;
+  const shade=.7+.3*Math.max(0,normal.dot(new T.Vector3(-.5,1,.6).normalize()));
+  const color=mesh.material.color.clone().multiplyScalar(shade).getStyle();
+  const points=[a.clone().project(camera),b.clone().project(camera),c.clone().project(camera)];
+  triangles.push({z:points.reduce((n,p)=>n+p.z,0)/3,svg:`<polygon points="${points.map(p=>`${((p.x+1)*500).toFixed(2)},${((1-p.y)*360).toFixed(2)}`).join(' ')}" fill="${color}" stroke="${color}" stroke-width=".4"/>`});
+ }
+ if(geo!==mesh.geometry)geo.dispose();
+});
+triangles.sort((a,b)=>b.z-a.z);
+await writeFile('assets/models/residential-study.svg',`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 720"><title>Illustrative residential architectural model</title>${triangles.map(t=>t.svg).join('')}</svg>`);
+disposeHouse(root);
+const bundle=await readFile('js/house-scene.js');
+console.log(`House bundle ${bundle.length} bytes / ${gzipSync(bundle).length} gzip; GLB ${glb.byteLength} bytes; poster ${triangles.length} triangles.`);
diff --git a/scripts/review-preview.mjs b/scripts/review-preview.mjs
new file mode 100644
index 0000000..4b83ec2
--- /dev/null
+++ b/scripts/review-preview.mjs
@@ -0,0 +1,26 @@
+import http from 'node:http';
+import {readFile} from 'node:fs/promises';
+import path from 'node:path';
+const root=path.resolve('_site'),port=Number(process.env.CC_PREVIEW_PORT||8891);
+const types={'.html':'text/html','.css':'text/css','.js':'text/javascript','.svg':'image/svg+xml','.glb':'model/gltf-binary','.png':'image/png','.jpg':'image/jpeg','.webp':'image/webp','.woff2':'font/woff2','.txt':'text/plain'};
+const server=http.createServer(async(req,res)=>{
+ try{
+  const url=new URL(req.url,'http://localhost');let route=decodeURIComponent(url.pathname),body,type;
+  if(route==='/__review/mobile'){
+   const pages=['/','/gallery/','/about/','/general-contractor-falmouth-ma/','/home-additions-cape-cod/','/adu-builder-cape-cod/','/home-renovation-cape-cod/','/custom-home-builder-cape-cod/','/construction-advisory/','/__house-prototype/'];
+   const width=[390,820].includes(Number(url.searchParams.get('width')))?Number(url.searchParams.get('width')):390;
+   let target=pages.includes(url.searchParams.get('path'))?url.searchParams.get('path'):'/';
+   if(['contact','house-explorer','services'].includes(url.searchParams.get('anchor')))target+='#'+url.searchParams.get('anchor');
+   body=`<!doctype html><meta name="robots" content="noindex"><title>${width}px responsive review</title><style>body{background:#d8d5cf;font:14px system-ui;margin:12px}iframe{display:block;width:${width}px;height:844px;border:1px solid #182b49;background:#f4f0e7}</style><p>${width}px viewport, real responsive document. Use the frame to navigate.</p><iframe title="Mobile website preview" src="${target}"></iframe>`;type='text/html';
+  }else if(route==='/__house-prototype/'){
+   const home=await readFile(path.join(root,'index.html'),'utf8');const scene=home.match(/<section class="house-section"[\s\S]*?<\/section>/)?.[0];
+   body=`<!doctype html><html lang="en"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex"><title>Residential house local prototype</title><link rel="stylesheet" href="/css/styles.css"><body><main>${scene}</main>${url.searchParams.get('no-webgl')==='1'?'<script>HTMLCanvasElement.prototype.getContext=function(){return null;}</script>':''}<script src="/js/house-loader.js"></script></body></html>`;type='text/html';
+  }else if(route==='/__review/select.js'){body=await readFile('scripts/review/select.js');type='text/javascript';}
+  else{
+   if(route.endsWith('/'))route+='index.html';const file=path.resolve(root,'.'+route);if(!file.startsWith(root+path.sep))throw Error('path');
+   body=await readFile(file);type=types[path.extname(file)]||'application/octet-stream';
+   if(type==='text/html'&&url.searchParams.get('review')==='1')body=body.toString().replace('</body>','<script src="/__review/select.js"></script></body>');
+  }
+  res.writeHead(200,{'content-type':type.startsWith('text/')?type+'; charset=utf-8':type,'cache-control':'no-store','x-robots-tag':'noindex'});res.end(body);
+ }catch{res.writeHead(404,{'content-type':'text/plain'});res.end('Not found');}
+});server.listen(port,'127.0.0.1',()=>console.log(`Local review http://127.0.0.1:${port}`));
