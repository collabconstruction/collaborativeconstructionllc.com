+import * as T from 'three';
+export const PALETTE = { ivory:0xf4f0e7, navy:0x182b49, brass:0xbda16a, stone:0xd6d0c3, glass:0x496477, timber:0xc4a574 };
+export function createHouse() {
+  const root = new T.Group(); root.name='Illustrative residential model';
+  const groups = {};
+  for (const name of ['site','foundation','frame','walls','roof','details','interior']) {
+    groups[name]=new T.Group(); groups[name].name=name; root.add(groups[name]);
+  }
+  const materials = Object.fromEntries(Object.entries(PALETTE).map(([name,color])=>[name,new T.MeshStandardMaterial({color,roughness:.88,metalness:0})]));
+  function box(group,size,pos,mat='ivory') {
+    const mesh=new T.Mesh(new T.BoxGeometry(...size),materials[mat]); mesh.position.set(...pos); groups[group].add(mesh); return mesh;
+  }
+  box('site',[9,.16,7],[0,-.16,0],'stone');
+  box('foundation',[6.2,.32,4.2],[0,.08,0],'stone');
+  box('foundation',[6,.12,4],[0,.3,0]);
+  // Structural framing is illustrative; not an engineering/construction specification.
+  for (const z of [-1.92,1.92]) {
+    for(let x=-2.9;x<=2.91;x+=.58) box('frame',[.085,2.35,.085],[x,1.52,z],'timber');
+    for(const y of [.38,2.69]) box('frame',[6,.1,.12],[0,y,z],'timber');
+  }
+  for (const x of [-2.92,2.92]) {
+    for(let z=-1.4;z<1.9;z+=.56) box('frame',[.085,2.35,.085],[x,1.52,z],'timber');
+    box('frame',[.12,.1,4],[x,2.69,0],'timber');
+  }
+  // Segmented front walls leave real openings around the glazing and door.
+  box('walls',[6,.65,.15],[0,.66,1.96]);
+  box('walls',[6,.42,.15],[0,2.48,1.96]);
+  for(const [x,w] of [[-2.75,.5],[-.95,.5],[.65,.45],[2.6,.8]]) box('walls',[w,1.5,.15],[x,1.63,1.96]);
+  box('walls',[6,2.35,.15],[0,1.52,-1.96]);
+  for(const x of [-2.96,2.96]) {
+    box('walls',[.15,.65,4],[x,.66,0]); box('walls',[.15,.42,4],[x,2.48,0]);
+    for(const z of [-1.65,.05,1.65]) box('walls',[.15,1.5,.65],[x,1.63,z]);
+  }
+  const gableShape=new T.Shape();gableShape.moveTo(-2,0);gableShape.lineTo(2,0);gableShape.lineTo(0,1.45);gableShape.closePath();
+  for(const x of [-3,3]) {const g=new T.Mesh(new T.ShapeGeometry(gableShape),materials.ivory);g.rotation.y=Math.PI/2;g.position.set(x,2.7,0);g.material=materials.ivory.clone();g.material.side=T.DoubleSide;groups.walls.add(g);}
+  // Pitched navy roof, ridge runs along the long axis.
+  const angle=Math.atan2(1.5,2.2), length=Math.hypot(1.5,2.2);
+  for(const sign of [-1,1]) {const roof=box('roof',[6.55,.11,length],[0,3.43,sign*1.1],'navy');roof.rotation.x=sign*angle;}
+  box('roof',[6.6,.1,.12],[0,4.18,0],'brass');
+  // Clean dark glazing with brass mullions.
+  for(const [x,w] of [[-1.85,1.25],[1.5,1.35]]) {
+    box('details',[w,1.42,.09],[x,1.63,1.99],'glass');
+    box('details',[.035,1.45,.12],[x,1.63,2.05],'brass');
+    box('details',[w+.08,.04,.14],[x,.9,2.04],'brass');
+    box('details',[w+.08,.04,.14],[x,2.36,2.04],'brass');
+  }
+  box('details',[.84,2.05,.12],[-.12,1.38,2],'navy');
+  box('details',[.07,.34,.08],[.15,1.35,2.09],'brass');
+  for(const x of [-3.01,3.01]) for(const z of [-.8,.85]) {box('details',[.08,1.42,.95],[x,1.63,z],'glass');box('details',[.12,1.45,.035],[x,1.63,z],'brass');}
+  // Entry landing and a modest side terrace.
+  box('details',[2,.18,1.1],[-.15,.18,2.48],'stone');
+  box('details',[2.4,.1,.5],[-.15,.02,3.08],'stone');
+  box('details',[1.5,.05,1.1],[-.15,-.05,3.12],'ivory');
+  for(const x of [-3.7,3.7]) for(const z of [-2,1.8]) {
+    box('details',[.65,.2,.65],[x,.01,z],'navy');
+    const plant=new T.Mesh(new T.IcosahedronGeometry(.4,1),new T.MeshStandardMaterial({color:0x69756b,roughness:1}));plant.position.set(x,.39,z);groups.details.add(plant);
+  }
+  // Simplified living-space cutaway, exposed voluntarily through Explore.
+  box('interior',[6,1.6,.15],[0,1.12,-1.96],'ivory');
+  box('interior',[.15,1.1,4],[-2.96,.87,0],'ivory');
+  box('interior',[5.65,.04,3.65],[0,.39,0],'timber');
+  box('interior',[1.9,.4,.78],[-1.4,.65,-.7],'ivory');
+  box('interior',[1.9,.6,.16],[-1.4,.95,-1.02],'stone');
+  box('interior',[.9,.3,.65],[-1.35,.58,.55],'navy');
+  box('interior',[1,.65,1],[1.4,.73,.1],'ivory');
+  box('interior',[2,.86,.55],[1.5,.82,-1.45],'stone');
+  box('interior',[2.05,.08,.6],[1.5,1.28,-1.45],'ivory');
+  groups.interior.visible=false;
+  return {root,groups};
+}
