--- /dev/null
+++ b/tests/house-experience.test.mjs
@@ -0,0 +1,40 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {assembly,scrollProgress,stageIndex} from '../lib/house/state.mjs';
+import {createHouse,disposeHouse} from '../lib/house/model.mjs';
+test('construction stages are bounded, ordered, complete and reversible',()=>{
+ const samples=[-1,0,.2,.4,.6,.8,1,2];
+ for(const p of samples){const s=Object.values(assembly(p));assert.ok(s.every(n=>n>=0&&n<=1));for(let i=1;i<s.length;i++)assert.ok(s[i]<=s[i-1]);}
+ assert.deepEqual(Object.values(assembly(1)),[1,1,1,1,1]);
+ const early=assembly(.3),late=assembly(.9);assert.ok(early.roof<late.roof);assert.deepEqual(assembly(.3),early);
+ assert.equal(stageIndex(1),3);assert.equal(stageIndex(0),0);
+ assert.ok(scrollProgress(-200,920,720)>scrollProgress(200,920,720));
+ assert.equal(scrollProgress(1000,920,720),0);
+});
+test('original house has finite geometry and a bounded triangle budget',()=>{
+ const {root,groups}=createHouse();let triangles=0;
+ for(const name of ['foundation','frame','walls','roof','details','interior'])assert.ok(groups[name].children.length>0);
+ root.traverse(o=>{if(!o.geometry)return;const p=o.geometry.attributes.position;for(const n of p.array)assert.ok(Number.isFinite(n));triangles+=(o.geometry.index?.count??p.count)/3;});
+ assert.ok(triangles<10000);assert.equal(groups.interior.visible,false);disposeHouse(root);
+});
+test('generated GLB contains independently editable construction groups',()=>{
+ const glb=fs.readFileSync(new URL('../assets/models/residential-study.glb',import.meta.url));assert.equal(glb.readUInt32LE(0),0x46546c67);assert.equal(glb.readUInt32LE(4),2);
+ const json=JSON.parse(glb.subarray(20,20+glb.readUInt32LE(12)).toString().trim());
+ for(const name of ['foundation','frame','walls','roof','details','interior'])assert.ok(json.nodes.some(node=>node.name===name));
+ assert.ok(glb.length<300000);assert.ok(json.buffers.every(buffer=>!buffer.uri));
+});
+
+test('reduced motion and save-data keep the renderer unloaded and controls honest',async()=>{
+ const {default:vm}=await import('node:vm');
+ const loader=fs.readFileSync(new URL('../js/house-loader.js',import.meta.url),'utf8');
+ for(const mode of ['reduce','save-data','static']){
+  const nodes=new Map();function node(key){if(!nodes.has(key))nodes.set(key,{hidden:false,disabled:false,value:'100',dataset:{},setAttribute(){},addEventListener(){}});return nodes.get(key);}
+  const section={querySelector:node,querySelectorAll:()=>[node('stage1'),node('stage2'),node('stage3'),node('stage4')],dataset:{},classList:{remove(){},add(){}},getBoundingClientRect:()=>({top:0,height:920})};
+  let observed;
+  const sandbox={document:{querySelector:()=>section},matchMedia:()=>({matches:mode==='reduce',addEventListener(){}}),navigator:{connection:{saveData:mode==='save-data'}},location:{search:mode==='static'?'?scene=static':''},URLSearchParams,window:{},addEventListener(){},IntersectionObserver:class{constructor(cb){observed=cb;}observe(){}},innerWidth:1280,innerHeight:720,requestAnimationFrame(){return 1},cancelAnimationFrame(){}};
+  sandbox.window=sandbox;
+  vm.runInNewContext(loader,sandbox);observed([{isIntersecting:true}]);
+  assert.equal(section.dataset.renderer,'static');assert.equal(node('[data-house-range]').disabled,true);assert.equal(node('[data-house-explore]').hidden,true);assert.equal(node('[data-house-skip]').hidden,true);
+ }
+});
