@@ -0,0 +1,46 @@
+/* Essential links and the architectural poster exist before this enhancement. */
+(() => {
+ const section=document.querySelector('[data-house]');if(!section)return;
+ const host=section.querySelector('.house-viewport'),controls=section.querySelector('.house-controls');
+ const range=section.querySelector('[data-house-range]'),buttons=[...section.querySelectorAll('[data-house-stage]')];
+ const title=section.querySelector('[data-stage-title]'),copy=section.querySelector('[data-stage-copy]');
+ const explore=section.querySelector('[data-house-explore]'),skip=section.querySelector('[data-house-skip]'),reset=section.querySelector('[data-house-reset]');
+ const motion=matchMedia('(prefers-reduced-motion: reduce)');
+ const stages=[['01 / Foundation','The starting point: site preparation and foundations.'],['02 / Structure','Framing establishes the shape and spaces of the home.'],['03 / Enclosure','Walls, glazing and roofing define the exterior.'],['04 / Completion','Interior finishes and exterior details complete the illustration.']];
+ let api=null,loading=false,failed=false,stopped=false,progress=1,manual=false,interior=false,raf=0,inView=false,generation=0;
+ const forcedStatic=new URLSearchParams(location.search).get('scene')==='static';
+ const lowData=navigator.connection?.saveData===true;
+ const allowed=()=>!motion.matches&&!lowData&&!forcedStatic&&!stopped;
+ controls.hidden=false;explore.hidden=false;skip.hidden=false;
+ function update(value,announce=false){explore.textContent=interior?'Show exterior':'Explore our services';progress=Math.max(0,Math.min(1,value));range.value=Math.round(progress*100);
+  const index=Math.min(3,Math.floor(progress*4));title.textContent=stages[index][0];copy.textContent=stages[index][1];
+  buttons.forEach((button,i)=>button.setAttribute('aria-pressed',String(index===i)));
+  if(announce) section.querySelector('[data-house-status]').textContent=interior?'Simplified interior view. Service links are below.':stages[index].join('. ');
+  api?.update(progress,interior);section.dataset.stage=String(index);
+ }
+ function staticControls(value){buttons.forEach(button=>button.disabled=value);range.disabled=value;reset.disabled=value;explore.hidden=value;}
+ function fallback(){staticControls(true);generation++;api?.dispose();api=null;section.classList.remove('house-ready');section.dataset.renderer='static';}
+ async function load(){if(api||loading||failed||!allowed())return;loading=true;const token=++generation;
+  try{const module=await import('/js/house-scene.js');if(token!==generation||!allowed())return;
+   api=module.mountHouse(host);api.visible(inView);api.update(progress,interior);staticControls(false);section.classList.add('house-ready');section.dataset.renderer='webgl';
+  }catch{failed=true;fallback();skip.hidden=true;section.querySelector('[data-house-status]').textContent='Static architectural illustration. All services remain available.';}
+  finally{loading=false;}
+ }
+ function measure(){raf=0;if(manual||!allowed()||!inView||innerWidth<760)return;const r=section.getBoundingClientRect();update(Math.max(0,Math.min(1,(innerHeight*.8-r.top)/Math.max(1,r.height-innerHeight*.35))));}
+ function onScroll(){if(!raf)raf=requestAnimationFrame(measure);}
+ buttons.forEach(button=>button.addEventListener('click',()=>{manual=true;interior=false;explore.setAttribute('aria-pressed','false');update(Number(button.dataset.houseStage),true);load();}));
+ range.addEventListener('input',()=>{manual=true;interior=false;explore.setAttribute('aria-pressed','false');update(Number(range.value)/100);load();});
+ range.addEventListener('change',()=>update(progress,true));
+ explore.addEventListener('click',()=>{manual=true;interior=!interior;explore.setAttribute('aria-pressed',String(interior));update(1,true);load();});
+ reset.addEventListener('click',()=>{manual=false;interior=false;explore.setAttribute('aria-pressed','false');update(1,true);measure();});
+ skip.addEventListener('click',()=>{stopped=!stopped;skip.textContent=stopped?'Enable 3D':'Skip motion';if(stopped){fallback();update(1,true);}else load();});
+ host.addEventListener('house-failed',()=>{failed=true;fallback();skip.hidden=true;section.querySelector('[data-house-status]').textContent='Static architectural illustration. All services remain available.';});
+ motion.addEventListener('change',()=>{if(!allowed()){fallback();update(1);}else load();});
+ const io='IntersectionObserver' in window?new IntersectionObserver(entries=>{inView=entries[0].isIntersecting;api?.visible(inView);if(inView){load();measure();}},{rootMargin:'160px'}):null;
+ if(io)io.observe(section);else{inView=true;load();}
+ addEventListener('scroll',onScroll,{passive:true});addEventListener('resize',onScroll,{passive:true});
+ addEventListener('pagehide',()=>{cancelAnimationFrame(raf);fallback();});
+ addEventListener('pageshow',event=>{if(event.persisted)load();});
+ update(1);
+ if(!allowed()){staticControls(true);skip.hidden=true;section.dataset.renderer='static';}
+})();
