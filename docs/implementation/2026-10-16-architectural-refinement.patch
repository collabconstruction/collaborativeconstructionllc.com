@@ -0,0 +1,18 @@
+/* Development-only selector. Served by review-preview.mjs, never copied to _site. */
+(() => {
+ const panel=document.createElement('aside');panel.id='cc-source-review';panel.style.cssText='position:fixed;right:12px;bottom:12px;width:min(370px,94vw);z-index:99999;background:#182b49;color:#fff;padding:18px;border:1px solid #bda16a;font:13px/1.5 system-ui;box-shadow:0 8px 30px #0004';
+ const label=document.createElement('strong');label.textContent='Local source review';
+ const help=document.createElement('p');help.textContent='Hold Alt and click a page element. Add an instruction, then copy the brief into Claude or Codex.';
+ const output=document.createElement('textarea');output.setAttribute('aria-label','Selected element and editing instruction');output.style.cssText='width:100%;height:160px;background:white;color:#111;padding:10px;font:12px/1.5 monospace';
+ const copy=document.createElement('button');copy.textContent='Copy edit brief';copy.style.cssText='margin-top:10px;background:#bda16a;color:#111;padding:9px;border:0';copy.onclick=()=>navigator.clipboard.writeText(output.value).then(()=>{copy.textContent='Copied';}).catch(()=>{output.select();copy.textContent='Select and copy the text';});
+ const close=document.createElement('button');close.textContent='Close';close.style.cssText='float:right;background:none;border:0;color:white';close.onclick=()=>panel.remove();panel.append(close,label,help,output,copy);document.body.append(panel);
+ document.addEventListener('click',event=>{if(!event.altKey||panel.contains(event.target))return;event.preventDefault();event.stopImmediatePropagation();
+  const e=event.target,section=e.closest('section,aside,header,footer');
+  const path=location.pathname;let source=path==='/'?'src/index.njk':path==='/about/'?'src/about.njk':path==='/gallery/'?'src/gallery.njk':`src${path}index.njk`;
+  if(path==='/construction-advisory/')source='src/construction-advisory.njk';
+  if(e.closest('.site-header,.site-footer'))source='src/_includes/base.njk';
+  if(e.closest('[data-house]'))source='src/_includes/house-explorer.njk';
+  output.value=`Page: ${path}\nSource: ${source}\nSection: ${section?.id||section?.className||'page'}\nElement: ${e.tagName.toLowerCase()}${e.id?'#'+e.id:''}${e.className&&typeof e.className==='string'?'.'+e.className.trim().split(/\s+/).join('.'):''}\nText: ${e.textContent.trim().slice(0,250)}\n\nRequested change: `;
+  output.focus();
+ },true);
+})();
