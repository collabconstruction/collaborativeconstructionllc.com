diff --git a/css/styles.css b/css/styles.css
index 6cf72b2..fede481 100644
--- a/css/styles.css
+++ b/css/styles.css
@@ -3760,3 +3760,40 @@ figure {
  .process.is-ready .process__step::before { animation-name: processLineVertical; }
 }
 @keyframes processLineVertical { from { transform: scaleY(0); } to { transform: scaleY(1); } }
+
+/* Service pages: scope tiles, image-led features and compact project evidence. */
+.service-page .section { padding-block: clamp(36px, 5vw, 70px); }
+.service-page .section-head { margin-bottom: 28px; }
+.service-page .section-head .rule { display: none; }
+.service-introduction { background: var(--white); }
+.scope-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
+.scope-tile { padding: 26px; border-top: 2px solid var(--brass); background: var(--paper); text-align: left; }
+.scope-tile__number { display: block; color: var(--navy-400); font-size: .75rem; letter-spacing: .12em; margin-bottom: 20px; }
+.scope-tile h3 { font-size: clamp(1.25rem, 2vw, 1.6rem); margin: 0 0 12px; }
+.scope-tile p { font-size: .95rem; color: var(--ink-muted); margin: 0; }
+.service-editorial { background: var(--navy); color: var(--paper); }
+.service-editorial h2, .service-editorial h3, .service-editorial p { color: var(--paper); }
+.service-editorial .eyebrow { color: var(--brass); }
+.service-editorial .service-summary { font-family: var(--font-display); font-size: clamp(1.4rem, 2.6vw, 2rem); line-height: 1.35; }
+.service-checks { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 14px; }
+.service-checks li { border-top: 1px solid rgba(189,161,106,.3); padding-top: 12px; }
+.service-projects { background: var(--white); }
+.service-page .service-projects .project { padding-block: 0; }
+.service-page .service-projects .project-head { display: grid; gap: 10px; margin-bottom: 18px; }
+.service-page .service-projects .project-head h2 { font-size: 1.65rem; }
+.service-details:nth-of-type(even) { background: var(--paper-2); }
+.service-page .svc-cta { background: var(--navy); color: var(--paper); }
+.service-page .svc-cta h2, .service-page .svc-cta p { color: var(--paper); }
+.service-page .svc-cta .eyebrow { color: var(--brass); }
+.project-gallery .gallery-note { padding: 0; border: 0; background: transparent; font-size: .875rem; max-width: 65ch; margin: 0 auto 30px; text-align: center; }
+.project-gallery .project-head { min-height: 98px; gap: 10px; margin-bottom: 14px; }
+.project-gallery .project { padding: 18px; }
+.project-gallery > .container > .project { margin-bottom: 28px; }
+.project-gallery .project-meta { letter-spacing: .06em; }
+.project-gallery .carousel__caption { font-size: .8rem; }
+@media (max-width: 680px) {
+ .scope-grid { grid-template-columns: 1fr; gap: 10px; }
+ .scope-tile { padding: 20px; }
+ .scope-tile__number { margin-bottom: 10px; }
+ .project-gallery .project-head { min-height: 0; }
+}
