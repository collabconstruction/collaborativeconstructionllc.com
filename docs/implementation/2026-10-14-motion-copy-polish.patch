+@media (prefers-reduced-motion: no-preference) {
+ .header-cta a::before, .svc-cta .btn::before, .hero__cta .btn-gold::before, .adu-card .btn::before { animation: contactShimmer 11s ease-in-out infinite; }
+}
+@keyframes contactShimmer { 0%, 85% { left: -60%; } 100% { left: 150%; } }
