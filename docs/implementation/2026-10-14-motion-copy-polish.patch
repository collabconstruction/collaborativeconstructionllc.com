+  from { transform: translateX(-50%) translate3d(20vw, -14vh, 0) scale(1.55) rotate(-17deg); opacity: 0; }
+  to { transform: translateX(-50%) translateY(calc(var(--drift, 0) * 1px)) scale(1); }
+}
