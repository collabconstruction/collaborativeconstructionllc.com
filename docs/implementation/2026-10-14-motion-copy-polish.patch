+}
+
+.values-sequence { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px 24px; margin: 0 auto 22px; color: var(--brass); font-family: var(--font-ui); font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .15em; }
+@media (prefers-reduced-motion: no-preference) {
