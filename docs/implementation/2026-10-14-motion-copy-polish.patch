+.location-atlas { display: flex; width: max-content; gap: 12px; margin: 0; padding: 0; list-style: none; align-items: center; }
+.location-atlas li { padding: 16px 20px; border: 1px solid var(--brass); border-radius: 28% 8% 24% 6%; color: var(--paper); background: var(--navy-800); white-space: nowrap; scroll-snap-align: start; }
+.location-atlas li:nth-child(3n+2) { border-color: var(--navy-200); border-radius: 5% 28% 6% 24%; transform: translateY(5px); }
+.location-atlas li:nth-child(3n) { border-color: var(--brass-300); transform: translateY(-4px); border-radius: 15% 4% 30% 6%; }
+@media (prefers-reduced-motion: no-preference) {
+ .locations--atlas::before { animation: atlasEdge 12s ease-in-out infinite alternate; }
+ .locations--atlas::after { animation: atlasEdge 16s ease-in-out infinite alternate-reverse; }
+}
+@keyframes atlasEdge { to { translate: 18px 0; } }
