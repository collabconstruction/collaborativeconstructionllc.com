+  const heroSurface = $(".hero");
+  if (heroSurface && !prefersReduced && matchMedia("(pointer: fine)").matches) {
+    let pendingPointer = null;
+    let pointerFrame = 0;
+    const paintPointer = () => {
+      pointerFrame = 0;
+      const point = pendingPointer;
+      heroSurface.style.setProperty("--pointer-x", point ? point.x + "px" : "0px");
+      heroSurface.style.setProperty("--pointer-y", point ? point.y + "px" : "0px");
+    };
+    heroSurface.addEventListener("pointermove", event => {
+      const box = heroSurface.getBoundingClientRect();
+      pendingPointer = { x: ((event.clientX - box.left) / box.width - .5) * 22,
+                         y: ((event.clientY - box.top) / box.height - .5) * 16 };
+      if (!pointerFrame) pointerFrame = requestAnimationFrame(paintPointer);
+    }, { passive: true });
+    heroSurface.addEventListener("pointerleave", () => { pendingPointer = null; if (!pointerFrame) pointerFrame = requestAnimationFrame(paintPointer); });
+    document.addEventListener("visibilitychange", () => { if (document.hidden) { pendingPointer = null; if (pointerFrame) cancelAnimationFrame(pointerFrame); pointerFrame = 0; paintPointer(); } });
+  }
