+.locations--atlas::before, .locations--atlas::after { content: ""; position: absolute; left: -2%; width: 104%; height: 8px; pointer-events: none; background: repeating-linear-gradient(118deg, var(--brass) 0 28px, var(--navy-200) 28px 49px, var(--brass-300) 49px 83px, var(--navy-400) 83px 116px); clip-path: polygon(0 25%, 8% 70%, 18% 0, 29% 80%, 42% 12%, 55% 90%, 69% 0, 82% 70%, 93% 12%, 100% 50%, 100% 100%, 0 100%); }
+.locations--atlas::before { top: 0; }
+.locations--atlas::after { bottom: 0; transform: rotate(180deg); }
+.location-controls { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 15px; }
+.location-label { color: var(--paper); font-size: .7rem; text-transform: uppercase; letter-spacing: .14em; }
+.location-arrows { display: flex; gap: 8px; }
