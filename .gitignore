# macOS
.DS_Store

# Editor / tooling
.claude/*
!.claude/skills/
.dev.vars

# Dependencies
node_modules/

# Python environment for scripts/build-workbooks.py. Recreate with:
#   python3.12 -m venv .venv-workbooks && .venv-workbooks/bin/pip install openpyxl==3.1.5
.venv-workbooks/

# Cloudflare Wrangler local state
.wrangler/

# one-off local utility scripts
remove_dashes.py

# Eleventy build output. Generated by `npm run build`, never edited by hand.
_site/

# Pre-migration snapshot of the live site, used only to diff the migration.
.baseline/

# Business exports and secrets are private; store outside this repo by preference.
/research-private/
/docs/research/private/

# Google OAuth client credentials and tokens must never live in this repo.
# Canonical private location: ~/.cc-private/gsc/oauth-client.json (outside this tree).
client_secret*.json
*.apps.googleusercontent.com.json
oauth-client.json
token.json
credentials.json
.cc-private/

# Built by scripts/build-live-overlay.mjs: a copy of the live site plus this branch's changes
_deploy/

# Python cache
__pycache__/

# Release tooling output (prepare report, overlay manifest, deploy logs)
.release/
# Overlay deploy folder built by scripts/build-live-overlay.mjs
_deploy/
# Generated by the monitor and audit scripts
monitoring-output/
.gallery-test-*/

# Local staging copy of owner-supplied source photos for one-off photo intakes.
# Raw originals (often with EXIF/GPS) must never be committed; only the
# processed assets/img output of scripts/process-new-project-photos.mjs ships.
.intake-staging/
